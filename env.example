# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA envie o arquivo ".env" para o GitHub.

# Porta em que a API vai rodar
PORT=3000

# URL do projeto no Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave "service_role" (Project Settings > API > service_role)
# Use SOMENTE no servidor. Nunca coloque no front-end.
SUPABASE_KEY=sua-chave-service-role-aqui
